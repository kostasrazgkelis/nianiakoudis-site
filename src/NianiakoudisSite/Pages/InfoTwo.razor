@page "/forologikes-ipiresies"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover" Src="@AssetUrl.WithVersion("assets/pictures/our-services-page-2.jpg")" Alt="@L["Contact.HeroImageAlt"]" Class="contact-hero elevator-reveal"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["Info.2.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudContainer Class="info-paragraph-container">
        <MudText Typo="Typo.body1" Class="service-paragraph">
            @L["Info.2.Paragraph1"]
        </MudText>
        <MudText Typo="Typo.body1" Class="service-paragraph">
            @L["Info.2.Paragraph2"]
        </MudText>
    </MudContainer>
</MudBox>


