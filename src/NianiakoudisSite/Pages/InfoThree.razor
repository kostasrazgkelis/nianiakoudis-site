@page "/simvouleftikes-ipiresies"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover" Src="@AssetUrl.WithVersion("assets/pictures/our-services-page-3.jpg")" Alt="@L["Contact.HeroImageAlt"]" Class="contact-hero elevator-reveal"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["Info.3.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudContainer Class="info-paragraph-container">
        <MudText Typo="Typo.body1" Class="service-paragraph">
            <TypewriterOnVisible Text="@L["Info.3.Paragraph1"].Value"
                                 OnCompleted="HandleFirstParagraphCompleted" />
        </MudText>
        @if (ShowSecondParagraph)
        {
            <MudText Typo="Typo.body1" Class="service-paragraph">
                <TypewriterOnVisible Text="@L["Info.3.Paragraph2"].Value" />
            </MudText>
        }
    </MudContainer>
</MudBox>

@code {
    private bool ShowSecondParagraph { get; set; }

    private Task HandleFirstParagraphCompleted()
    {
        ShowSecondParagraph = true;
        return InvokeAsync(StateHasChanged);
    }
}

