@page "/forologikoi-elegxoi"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover" Src="@AssetUrl.WithVersion("assets/pictures/our-services-page-4.jpg")" Alt="@L["Contact.HeroImageAlt"]" Class="contact-hero elevator-reveal"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["Info.4.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudContainer Class="info-paragraph-container">
        <MudText Typo="Typo.body1" Class="service-paragraph">
            <TypewriterOnVisible Text="@L["Info.4.Paragraph1"].Value" SpeedMs="25" StartDelayMs="0" />
        </MudText>
        <MudText Typo="Typo.body1" Class="service-paragraph">
            <TypewriterOnVisible Text="@L["Info.4.Paragraph2"].Value" SpeedMs="25" StartDelayMs="220" />
        </MudText>
    </MudContainer>

</MudBox>

