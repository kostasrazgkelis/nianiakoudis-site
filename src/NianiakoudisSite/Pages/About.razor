@page "/about"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover"
                  Src="@AssetUrl.WithVersion("assets/pictures/about-us-page.jpg")"
                  Alt="@L["About.HeroImageAlt"]"
                  Class="contact-hero contact-slide-up"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["About.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph1"].Value" SpeedMs="25" StartDelayMs="0" />
    </MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph2"].Value" SpeedMs="25" StartDelayMs="200" />
    </MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph3"].Value" SpeedMs="25" StartDelayMs="400" />
    </MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph4"].Value" SpeedMs="25" StartDelayMs="600" />
    </MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph5"].Value" SpeedMs="25" StartDelayMs="800" />
    </MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph6"].Value" SpeedMs="25" StartDelayMs="1000" />
    </MudText>
</MudBox>

