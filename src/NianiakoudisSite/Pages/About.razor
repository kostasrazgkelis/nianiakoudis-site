@page "/about"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover"
                  Src="@AssetUrl.WithVersion("assets/pictures/about-us-page.jpg")"
                  Alt="@L["About.HeroImageAlt"]"
                  Class="contact-hero contact-slide-up"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["About.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudText Typo="Typo.body1" Class="about-paragraph">
        <TypewriterOnVisible Text="@L["About.Paragraph1"].Value"
                             SpeedMs="15"
                             StartDelayMs="0"
                             OnCompleted="@(() => HandleParagraphCompleted(1))" />
    </MudText>
    @if (VisibleParagraphs >= 2)
    {
        <MudText Typo="Typo.body1" Class="about-paragraph">
            <TypewriterOnVisible Text="@L["About.Paragraph2"].Value"
                                 SpeedMs="15"
                                 StartDelayMs="0"
                                 OnCompleted="@(() => HandleParagraphCompleted(2))" />
        </MudText>
    }
    @if (VisibleParagraphs >= 3)
    {
        <MudText Typo="Typo.body1" Class="about-paragraph">
            <TypewriterOnVisible Text="@L["About.Paragraph3"].Value"
                                 SpeedMs="15"
                                 StartDelayMs="0"
                                 OnCompleted="@(() => HandleParagraphCompleted(3))" />
        </MudText>
    }
    @if (VisibleParagraphs >= 4)
    {
        <MudText Typo="Typo.body1" Class="about-paragraph">
            <TypewriterOnVisible Text="@L["About.Paragraph4"].Value"
                                 SpeedMs="15"
                                 StartDelayMs="0"
                                 OnCompleted="@(() => HandleParagraphCompleted(4))" />
        </MudText>
    }
    @if (VisibleParagraphs >= 5)
    {
        <MudText Typo="Typo.body1" Class="about-paragraph">
            <TypewriterOnVisible Text="@L["About.Paragraph5"].Value"
                                 SpeedMs="15"
                                 StartDelayMs="0"
                                 OnCompleted="@(() => HandleParagraphCompleted(5))" />
        </MudText>
    }
    @if (VisibleParagraphs >= 6)
    {
        <MudBox Class="about-last-block">
            <MudText Typo="Typo.body1" Class="about-paragraph">
                <TypewriterOnVisible Text="@L["About.Paragraph6"].Value"
                                     SpeedMs="15"
                                     StartDelayMs="0"
                                     OnCompleted="@(() => HandleParagraphCompleted(6))" />
            </MudText>
            @if (ShowFlags)
            {
                <MudBox Class="about-flags" aria-label="Χώρες δραστηριοποίησης">
                    <span class="about-flag-chip about-flag-chip--greece">
                        <span class="about-flag-icon" aria-hidden="true">
                            <Blazicon Svg="FlagIcon4x3.Gr" />
                        </span>
                        Ελλάδα
                    </span>
                    <span class="about-flag-chip about-flag-chip--cyprus">
                        <span class="about-flag-icon" aria-hidden="true">
                            <Blazicon Svg="FlagIcon4x3.Cy" />
                        </span>
                        Κύπρος
                    </span>
                    <span class="about-flag-chip about-flag-chip--balkans">Βαλκάνια</span>
                </MudBox>
            }
        </MudBox>
    }
</MudBox>

@code {
    private int VisibleParagraphs { get; set; } = 1;
    private bool ShowFlags { get; set; }

    private Task HandleParagraphCompleted(int paragraphIndex)
    {
        var nextParagraph = paragraphIndex + 1;
        if (nextParagraph <= 6 && VisibleParagraphs < nextParagraph)
        {
            VisibleParagraphs = nextParagraph;
        }

        if (paragraphIndex == 6)
        {
            ShowFlags = true;
        }

        return InvokeAsync(StateHasChanged);
    }
}

