@page "/about"

<MudBox Class="home-stack info-stack">

    <MudContainer Class="info-hero">
        <MudImage ObjectFit="ObjectFit.Cover"
                  Src="@AssetUrl.WithVersion("assets/pictures/about-us-page.jpg")"
                  Alt="@L["About.HeroImageAlt"]"
                  Class="contact-hero contact-slide-up"/>

        <MudPaper Class="info-page" Square="true" Elevation="2">
            <MudText Typo="Typo.h4">@L["About.Title"]</MudText>
        </MudPaper>
    </MudContainer>

    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph1"]</MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph2"]</MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph3"]</MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph4"]</MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph5"]</MudText>
    <MudText Typo="Typo.body1" Class="about-paragraph">@L["About.Paragraph6"]</MudText>
</MudBox>
