@page "/"
@inject IJSRuntime JsRuntime

<MudCollapse Expanded="@ShowCarousel" Class="@($"home-carousel-collapse {(DisableHomeAnimations ? "home-no-anim" : string.Empty)}")">
    <MudStack Spacing="16">
        <MudPaper Class="home-carousel-shell" Square="true" Elevation="1">
            <MudCarousel TData="HomeRow" EnableSwipeGesture="true" Class="home-carousel" ShowArrows="false" ShowBullets="true" AutoCycle="true" AutoCycleTime="@TimeSpan.FromSeconds(6)" BulletsColor="Color.Primary" BulletsClass="home-bullets">
                <MudCarouselItem Class="@($"hero-transition {(HeroVisible ? "is-visible" : string.Empty)}")">
                    <MudPaper Class="home-hero hero" Square="true" Elevation="1">
                        <picture class="home-hero-image">
                            <source srcset="@HeroAvifImageUrl" type="image/avif" />
                            <source srcset="@HeroWebpImageUrl" type="image/webp" />
                            <img src="@HeroJpgImageUrl"
                                 alt="@L["Home.Hero.ImageAlt"]"
                                 class="home-hero-image"
                                 width="1280"
                                 height="853"
                                 loading="eager"
                                 fetchpriority="high"
                                 decoding="async"
                                 sizes="100vw" />
                        </picture>
                        <MudBox Class="home-hero-text">
                            <MudText Typo="Typo.body2" Class="home-hero-paragraph home-hero-paragraph-first">
                                @L["Home.Hero.Line1"]
                            </MudText>
                            <MudText Typo="Typo.body2" Class="home-hero-paragraph home-hero-paragraph-third">
                                @L["Home.Hero.Line3Prefix"] <span class="home-hero-paragraph-delayed">@L["Home.Hero.Line3Suffix"]</span>
                            </MudText>
                        </MudBox>
                    </MudPaper>
                </MudCarouselItem>

                @for (var index = 0; index < Rows.Count; index++)
                {
                    var row = Rows[index];
                    var rowClass = index % 2 == 1 ? "home-row reverse" : "home-row";

                    <MudCarouselItem Class="@rowClass">
                        <MudPaper Class="home-row-card" Square="true" Elevation="1">
                            <MudGrid Class="home-row-grid" Spacing="0">
                                <MudItem xs="12" md="6" Class="home-copy">
                                    <MudText Typo="Typo.h5">@row.Title</MudText>
                                    <MudText Typo="Typo.body1" Class="home-body">@row.Body</MudText>
                                    <MudButton Class="info-button" Variant="Variant.Filled" Color="Color.Secondary" Href="@row.Link">
                                        @L["Home.LearnMore"]
                                    </MudButton>
                                </MudItem>
                                <MudItem xs="12" md="6" Class="home-visual">
                                    <picture class="home-image">
                                        <source srcset="@row.ImageAvifUrl" type="image/avif" />
                                        <source srcset="@row.ImageWebpUrl" type="image/webp" />
                                        <img src="@row.ImageJpgUrl"
                                             alt="@row.ImageAlt"
                                             class="home-image"
                                             loading="lazy"
                                             decoding="async"
                                             width="1280"
                                             height="853" />
                                    </picture>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudCarouselItem>
                }
            </MudCarousel>
        </MudPaper>

        <MudPaper Elevation="0" Class="home-flow-section">
            <HomeFlow Items="FlowItems" Duration="11s">
                <HeaderContent>
                    <MudBox Class="home-flow-header home-container" data-flow-index="0">
                        <MudText Typo="Typo.h4" Class="home-flow-longform-title">
                            @L["Home.Flow.HeaderTitle"]
                        </MudText>
                    </MudBox>
                </HeaderContent>
                <ChildContent>
                    <MudBox Class="home-flow-longform home-container" data-flow-index="4">
                        <MudText Typo="Typo.h4" Class="home-flow-longform-title">
                            @L["Home.Flow.OverviewTitle"]
                        </MudText>
                        <MudText Typo="Typo.body1" Class="home-flow-longform-body">
                            @L["Home.Flow.OverviewParagraph1"]
                        </MudText>
                        <MudText Typo="Typo.body1" Class="home-flow-longform-body">
                            @L["Home.Flow.OverviewParagraph2"]
                        </MudText>
                    </MudBox>

                    <MudBox Class="home-flow-extra">
                        <MudBox Class="home-container home-flow-extra-header" data-flow-index="5">
                            <MudText Typo="Typo.h4" Class="home-flow-longform-title">
                                @L["Home.Flow.ExtraTitle"]
                            </MudText>
                            <MudText Typo="Typo.subtitle1" Class="home-flow-extra-body">
                                @L["Home.Flow.ExtraBody"]
                            </MudText>
                        </MudBox>

                        <MudBox Class="home-flow-extra-grid">
                            @foreach (var card in FlowExtraCards)
                            {
                                <MudLink Href="@card.Link" Class="home-flow-extra-link" Underline="Underline.None">
                                    <MudPaper Class="box-1-card home-container home-flow-extra-card"
                                              Square="true"
                                              Elevation="2"
                                              data-flow-index="@card.FlowIndex">
                                        <MudText Typo="Typo.h6" Class="home-flow-extra-card-title">
                                            @card.Title
                                        </MudText>
                                        <MudText Typo="Typo.subtitle2" Class="home-flow-extra-card-body">
                                            @card.Body
                                        </MudText>
                                    </MudPaper>
                                </MudLink>
                            }
                        </MudBox>
                    </MudBox>

                    <MudContainer Class="box-1 home-container" data-flow-index="11">
                        <MudGrid Class="box-1-grid" Spacing="2">
                            <MudItem xs="12" md="12" Class="box-1-left">
                                <MudText Typo="Typo.h5" Class="box-1-title">@L["Home.Flow.ContactBoxTitle"]</MudText>
                                <MudText Typo="Typo.body1" Class="box-1-subtitle">
                                    @L["Home.Flow.ContactBoxBody"]
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="12">
                                <MudGrid Class="box-1-cards" Spacing="2">
                                    <MudItem xs="12" md="4">
                                        <MudPaper Class="box-1-card" Square="true" Elevation="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Email" Class="box-1-card-icon" />
                                            <MudText Typo="Typo.subtitle2" Class="box-1-card-title">@L["Home.Contact.EmailTitle"]</MudText>
                                            <MudLink Href="@($"mailto:{L["Common.Email"]}")" Class="box-1-link">
                                                @L["Common.Email"]
                                            </MudLink>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudPaper Class="box-1-card" Square="true" Elevation="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Phone" Class="box-1-card-icon" />
                                            <MudText Typo="Typo.subtitle2" Class="box-1-card-title">@L["Home.Contact.PhoneTitle"]</MudText>
                                            <MudLink Href="@($"tel:{L["Common.PhoneHref"]}")" Class="box-1-link">
                                                @L["Common.PhoneText"]
                                            </MudLink>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudPaper Class="box-1-card" Square="true" Elevation="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Business" Class="box-1-card-icon" />
                                            <MudText Typo="Typo.subtitle2" Class="box-1-card-title">@L["Home.Contact.LinkedInTitle"]</MudText>
                                            <MudLink Href="@L["Common.LinkedInHref"]" Target="_blank" rel="noopener noreferrer" Class="box-1-link">
                                                @L["Home.Contact.LinkedInText"]
                                            </MudLink>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudContainer>
                </ChildContent>
            </HomeFlow>
        </MudPaper>
    </MudStack>
</MudCollapse>

@code {
    private static bool HomeIntroAlreadyPlayed;

    private IReadOnlyList<HomeRow> Rows { get; set; } = Array.Empty<HomeRow>();
    private IReadOnlyList<HomeFlowItem> FlowItems { get; set; } = Array.Empty<HomeFlowItem>();
    private IReadOnlyList<FlowExtraCard> FlowExtraCards { get; set; } = Array.Empty<FlowExtraCard>();

    private sealed record HomeRow(
        string Title,
        string Body,
        string Link,
        string ImageJpgUrl,
        string ImageWebpUrl,
        string ImageAvifUrl,
        string ImageAlt);

    private sealed record FlowExtraCard(string Title, string Body, int FlowIndex, string Link);

    private bool HeroVisible { get; set; }
    private bool ShowCarousel { get; set; }
    private bool DisableHomeAnimations { get; set; }

    private string HeroJpgImageUrl { get; } = AssetUrl.WithVersion("assets/pictures/carousel-picture-1.jpg");
    private string HeroWebpImageUrl { get; } = AssetUrl.WithVersion("assets/pictures/carousel-picture-1.webp");
    private string HeroAvifImageUrl { get; } = AssetUrl.WithVersion("assets/pictures/carousel-picture-1.avif");

    protected override void OnInitialized()
    {
        DisableHomeAnimations = HomeIntroAlreadyPlayed;
        if (DisableHomeAnimations)
        {
            HeroVisible = true;
            ShowCarousel = true;
        }

        Rows = new List<HomeRow>
        {
            new HomeRow(
                L["Home.FlowExtra1.Title"].Value,
                L["Home.FlowExtra1.Body"].Value,
                "/logistikes-ipiresies",
                AssetUrl.WithVersion("assets/pictures/carousel-picture-2.jpg"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-2.webp"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-2.avif"),
                L["Home.Row1.ImageAlt"].Value),
            new HomeRow(
                L["Home.FlowExtra2.Title"].Value,
                L["Home.FlowExtra2.Body"].Value,
                "/forologikes-ipiresies",
                AssetUrl.WithVersion("assets/pictures/carousel-picture-3.jpg"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-3.webp"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-3.avif"),
                L["Home.Row2.ImageAlt"].Value),
            new HomeRow(
                L["Home.FlowExtra3.Title"].Value,
                L["Home.FlowExtra3.Body"].Value,
                "/simvouleftikes-ipiresies",
                AssetUrl.WithVersion("assets/pictures/carousel-picture-4.jpg"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-4.webp"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-4.avif"),
                L["Home.Row3.ImageAlt"].Value),
            new HomeRow(
                L["Home.FlowExtra4.Title"].Value,
                L["Home.FlowExtra4.Body"].Value,
                "/forologikoi-elegxoi",
                AssetUrl.WithVersion("assets/pictures/carousel-picture-5.jpg"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-5.webp"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-5.avif"),
                L["Home.Row4.ImageAlt"].Value),
            new HomeRow(
                L["Home.FlowExtra5.Title"].Value,
                L["Home.FlowExtra5.Body"].Value,
                "/misthodosia",
                AssetUrl.WithVersion("assets/pictures/carousel-picture-6.jpg"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-6.webp"),
                AssetUrl.WithVersion("assets/pictures/carousel-picture-6.avif"),
                L["Home.Row5.ImageAlt"].Value)
        };

        FlowItems = new[]
        {
            new HomeFlowItem(
                L["Home.FlowItem1.Title"].Value,
                new[]
                {
                    L["Home.FlowItem1.Line1"].Value
                },
                GridColumn: 1,
                GridRow: 1,
                FlowIndex: 1),
            new HomeFlowItem(
                L["Home.FlowItem2.Title"].Value,
                new[]
                {
                    L["Home.FlowItem2.Line1"].Value
                },
                GridColumn: 3,
                GridRow: 2,
                FlowIndex: 2),
            new HomeFlowItem(
                L["Home.FlowItem3.Title"].Value,
                new[]
                {
                    L["Home.FlowItem3.Line1"].Value
                },
                GridColumn: 2,
                GridRow: 3,
                FlowIndex: 3)
        };

        FlowExtraCards = new[]
        {
            new FlowExtraCard(
                L["Home.FlowExtra1.Title"].Value,
                L["Home.FlowExtra1.Body"].Value,
                6,
                "/logistikes-ipiresies"),
            new FlowExtraCard(
                L["Home.FlowExtra2.Title"].Value,
                L["Home.FlowExtra2.Body"].Value,
                7,
                "/forologikes-ipiresies"),
            new FlowExtraCard(
                L["Home.FlowExtra3.Title"].Value,
                L["Home.FlowExtra3.Body"].Value,
                8,
                "/simvouleftikes-ipiresies"),
            new FlowExtraCard(
                L["Home.FlowExtra4.Title"].Value,
                L["Home.FlowExtra4.Body"].Value,
                9,
                "/forologikoi-elegxoi"),
            new FlowExtraCard(
                L["Home.FlowExtra5.Title"].Value,
                L["Home.FlowExtra5.Body"].Value,
                10,
                "/misthodosia")
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            HeroVisible = true;
            ShowCarousel = true;

            if (DisableHomeAnimations)
            {
                await JsRuntime.InvokeVoidAsync("homeSectionsObserver.init", ".home-flow", new { disableAnimation = true });
                await JsRuntime.InvokeVoidAsync("revealOnScroll.init", ".home-row, .home-hero, .home-flow-section, .home-flow-header", new { disableAnimation = true });
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("homeSectionsObserver.init", ".home-flow");
                await JsRuntime.InvokeVoidAsync("revealOnScroll.init", ".home-row, .home-hero, .home-flow-section, .home-flow-header");
                HomeIntroAlreadyPlayed = true;
            }

            await InvokeAsync(StateHasChanged);
        }
    }
}
