@implements IDisposable
@inject IJSRuntime JsRuntime

<span class="@Class" @ref="_anchor">
    @if (_started)
    {
        <Typewriter @key="_instanceKey" Speed="@SpeedCharsPerSecond" Autostart="true">
            <span @key="_instanceKey">@Text</span>
        </Typewriter>
    }
</span>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public int SpeedMs { get; set; } = 25;

    [Parameter]
    public int StartDelayMs { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private ElementReference _anchor;
    private DotNetObjectReference<TypewriterOnVisible>? _dotNetRef;
    private bool _started;
    private readonly string _instanceKey = Guid.NewGuid().ToString("N");
    private int SpeedCharsPerSecond => Math.Max(1, 1000 / Math.Max(1, SpeedMs));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync(
            "visibilityObserver.observeElementOnce",
            _anchor,
            _dotNetRef,
            nameof(StartTyping));
    }

    [JSInvokable]
    public Task StartTyping()
    {
        if (_started)
        {
            return Task.CompletedTask;
        }

        _started = true;
        return StartDelayMs > 0
            ? InvokeAsync(async () =>
            {
                await Task.Delay(StartDelayMs);
                await InvokeAsync(StateHasChanged);
            })
            : InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
