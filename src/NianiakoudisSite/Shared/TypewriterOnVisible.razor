@implements IDisposable
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<span class="@Class" @ref="_anchor">
    @if (_skipAnimation)
    {
        @Text
    }
    else if (_animateByWords && _started)
    {
        <span class="typewriter-word-stream">
            @foreach (var token in _visibleWordTokens)
            {
                if (token.IsWord)
                {
                    <span class="typewriter-word-token typewriter-word-token--fade" @key="token.Id">@token.Text</span>
                }
                else
                {
                    @token.Text
                }
            }
        </span>
    }
    else if (_started)
    {
        <Typewriter @key="_instanceKey" Speed="@SpeedCharsPerSecond" Autostart="true" OnComplete="@HandleComplete">
            <span @key="_instanceKey">@Text</span>
        </Typewriter>
    }
</span>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public int SpeedMs { get; set; } = 10;

    [Parameter]
    public int StartDelayMs { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [Parameter]
    public string? AnimationKey { get; set; }

    [Parameter]
    public bool AnimateByWords { get; set; } = true;

    private static readonly HashSet<string> PlayedAnimationKeys = new(StringComparer.Ordinal);
    private static readonly object PlayedAnimationKeysLock = new();

    private ElementReference _anchor;
    private DotNetObjectReference<TypewriterOnVisible>? _dotNetRef;
    private bool _started;
    private bool _animateByWords;
    private bool _skipAnimation;
    private bool _completionRaised;
    private int _tokenSequence;
    private readonly List<RenderedToken> _visibleWordTokens = [];
    private string _resolvedAnimationKey = string.Empty;
    private readonly string _instanceKey = Guid.NewGuid().ToString("N");
    private int SpeedCharsPerSecond => Math.Max(1, 1000 / Math.Max(1, SpeedMs));
    private int WordStepDelayMs => Math.Max(30, SpeedMs * 6);

    protected override void OnParametersSet()
    {
        _resolvedAnimationKey = ResolveAnimationKey();
        _skipAnimation = HasAnimationPlayed(_resolvedAnimationKey);
        _animateByWords = AnimateByWords;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (_skipAnimation)
        {
            await HandleComplete();
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync(
            "visibilityObserver.observeElementOnce",
            _anchor,
            _dotNetRef,
            nameof(StartTyping));
    }

    [JSInvokable]
    public Task StartTyping()
    {
        if (_skipAnimation || _started)
        {
            return Task.CompletedTask;
        }

        MarkAnimationAsPlayed(_resolvedAnimationKey);
        _started = true;

        if (_animateByWords)
        {
            return InvokeAsync(async () =>
            {
                if (StartDelayMs > 0)
                {
                    await Task.Delay(StartDelayMs);
                }

                await RunWordAnimationAsync();
            });
        }

        return StartDelayMs > 0
            ? InvokeAsync(async () =>
            {
                await Task.Delay(StartDelayMs);
                await InvokeAsync(StateHasChanged);
            })
            : InvokeAsync(StateHasChanged);
    }

    private string ResolveAnimationKey()
    {
        if (!string.IsNullOrWhiteSpace(AnimationKey))
        {
            return AnimationKey.Trim();
        }

        var route = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var normalizedRoute = string.IsNullOrWhiteSpace(route) ? "/" : route;
        return $"{normalizedRoute}|{Text}";
    }

    private static bool HasAnimationPlayed(string key)
    {
        lock (PlayedAnimationKeysLock)
        {
            return PlayedAnimationKeys.Contains(key);
        }
    }

    private static void MarkAnimationAsPlayed(string key)
    {
        lock (PlayedAnimationKeysLock)
        {
            PlayedAnimationKeys.Add(key);
        }
    }

    private async Task RunWordAnimationAsync()
    {
        var tokens = SplitIntoWordTokens(Text);
        if (tokens.Length == 0)
        {
            await HandleComplete();
            return;
        }

        _tokenSequence = 0;
        _visibleWordTokens.Clear();

        var totalWords = tokens.Count(IsWordToken);
        var revealedWords = 0;

        for (var i = 0; i < tokens.Length; i++)
        {
            var token = tokens[i];
            var isWord = IsWordToken(token);
            _visibleWordTokens.Add(new RenderedToken(++_tokenSequence, token, isWord));
            await InvokeAsync(StateHasChanged);

            if (!isWord)
            {
                continue;
            }

            revealedWords++;
            if (revealedWords < totalWords)
            {
                await Task.Delay(WordStepDelayMs);
            }
        }

        await HandleComplete();
    }

    private static string[] SplitIntoWordTokens(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Array.Empty<string>();
        }

        var tokens = new List<string>();
        var tokenStart = -1;

        for (var i = 0; i < text.Length; i++)
        {
            var currentChar = text[i];
            if (!char.IsWhiteSpace(currentChar))
            {
                tokenStart = tokenStart == -1 ? i : tokenStart;
                continue;
            }

            if (tokenStart != -1)
            {
                tokens.Add(text[tokenStart..(i + 1)]);
                tokenStart = -1;
            }
            else
            {
                tokens.Add(currentChar.ToString());
            }
        }

        if (tokenStart != -1)
        {
            tokens.Add(text[tokenStart..]);
        }

        return tokens.ToArray();
    }

    private static bool IsWordToken(string token)
    {
        foreach (var character in token)
        {
            if (!char.IsWhiteSpace(character))
            {
                return true;
            }
        }

        return false;
    }

    private async Task HandleComplete()
    {
        if (_completionRaised)
        {
            return;
        }

        _completionRaised = true;
        if (OnCompleted.HasDelegate)
        {
            await OnCompleted.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private sealed record RenderedToken(int Id, string Text, bool IsWord);
}
